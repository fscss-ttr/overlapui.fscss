{
  "name": "overlapui",
  "version": "1.0.0",
  "description": "CSS-first overlapping UI stacks for FSCSS — plus plain overlapui.css for non-FSCSS pages",
  "main": "overlapui.fscss",
  "style": "overlapui.css",
  "extension": "fscss",
  "fscss_version": ">=1.2.3",
  "engines": {
    "fscss": ">=1.2.3"
  },
  "files": [
    "overlapui.fscss",
    "overlapui.standalone.fscss",
    "overlapui.css",
    "overlapui.min.css",
    "README.md",
    "templates",
    "xfcmds"
  ],
  "scripts": {
    "build:css": "fscss overlapui.standalone.fscss overlapui.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fscss-ttr/overlapui.fscss.git"
  },
  "homepage": "https://github.com/fscss-ttr/overlapui.fscss#readme",
  "bugs": {
    "url": "https://github.com/fscss-ttr/overlapui.fscss/issues"
  },
  "author": {
    "name": "Figsh",
    "url": "https://github.com/Figsh"
  },
  "contributors": [
    {
      "name": "fscss-ttr",
      "url": "https://github.com/fscss-ttr"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Figsh"
  },
  "file": {
    "usage": {
      "directive": "",
      "helpers": [
        "ou-root(root:root)",
        "ou-avatar-size(size:44px, overlap:-14px)",
        "ou-card-size(peek:34px, height:76px)",
        "ou-img-size(size:96px, overlap:-52px)",
        "ou-circle-size(item:48px, radius:86px)",
        "ou-avatar-colors()",
        "avatar-overlap(sel:.avatar-overlap)",
        "card-overlap(sel:.card-overlap)",
        "img-overlap(sel:.img-overlap)",
        "circle-overlap(sel:.circle-overlap)",
        "ou-reduced-motion()",
        "overlapui()"
      ]
    },
    "modules": ["./overlapui.fscss"],
    "remote": "./overlapui.fscss"
  },
  "xfcmd": {
    "enable": "./xfcmds/enable.xfcmd",
    "disable": "./xfcmds/disable.xfcmd"
  },
  "keywords": [
    "fscss",
    "css",
    "overlap",
    "avatar",
    "ui",
    "circle-menu",
    "card-stack"
  ],
  "license": "MIT"
}
