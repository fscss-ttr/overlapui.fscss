# xfcmds/enable.xfcmd
# libck overlapui → yes  |  libon overlapui
# https://github.com/fscss-ttr/overlapui.fscss
say "Setting up {name}@{version} by {author}"
say "Needs FSCSS {fscss}. Import: @import((*) from overlapui)"
add snippets for helpers
add snippet ou-import "import overlapui selective" as "@import((\n  ou-root,\n  ou-avatar-colors,\n  avatar-overlap,\n  circle-overlap,\n  ou-reduced-motion\n) from overlapui)"
add snippet ou-avatar-demo "avatar stack markup" as "<ul class=\"avatar-overlap\" tabindex=\"0\">\n  <li data-alph=\"g\">Gina</li>\n  <li data-alph=\"h\">Hank</li>\n  <li data-alph=\"i\">Ivy</li>\n  <li data-alph=\"j\">Jay</li>\n</ul>"
add snippet ou-circle-demo "circle menu markup" as "<div class=\"circle-overlap\" style=\"--n:5\" tabindex=\"0\">\n  <button type=\"button\" aria-label=\"Menu\">+</button>\n  <a href=\"#\" aria-label=\"Home\">H</a>\n  <a href=\"#\" aria-label=\"Search\">S</a>\n  <a href=\"#\" aria-label=\"Chat\">C</a>\n  <a href=\"#\" aria-label=\"Groups\">G</a>\n  <a href=\"#\" aria-label=\"Profile\">P</a>\n</div>"
create file "overlapui-demo/demo.fscss" with:
  /* overlapui demo — generated by xfcmd */
  @import((*) from overlapui)

  @ou-root()
  @avatar-overlap(.avatar-overlap)
  @circle-overlap(.circle-overlap)
  @ou-reduced-motion()

  :root {
    --ou-ring: #0f172a;
    --ou-center-bg: #6366f1;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    gap: 48px;
    padding: 32px 16px;
    background: #0b1220;
    font-family: system-ui, sans-serif;
    color: #e2e8f0;
  }

  h1 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    opacity: 0.75;
  }
end
create file "overlapui-demo/index.html" with:
  <!DOCTYPE html>
  <html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>overlapui demo</title>
    <link type="fscss" href="demo.fscss">
  </head>
  <body>
    <h1>overlapui — avatar + circle</h1>
    <ul class="avatar-overlap" tabindex="0">
      <li data-alph="g">Gina</li>
      <li data-alph="h">Hank</li>
      <li data-alph="i">Ivy</li>
      <li data-alph="j">Jay</li>
    </ul>
    <div class="circle-overlap" style="--n:5" tabindex="0">
      <button type="button" aria-label="Menu">+</button>
      <a href="#" aria-label="Home">H</a>
      <a href="#" aria-label="Search">S</a>
      <a href="#" aria-label="Chat">C</a>
      <a href="#" aria-label="Groups">G</a>
      <a href="#" aria-label="Profile">P</a>
    </div>
  </body>
  </html>
end
open file overlapui-demo/demo.fscss
compile
open file overlapui-demo/index.html
show preview
say "Done. Type ou-root, avatar-overlap, or circle-overlap for snippets."
say "CSS-only users: npm install overlapui → link overlapui.css (no FSCSS needed)."
